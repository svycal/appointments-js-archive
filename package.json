{
  "name": "@savvycal/appointments",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "playground": "cd playground && mix setup && mix phx.server",
    "typecheck": "pnpm -r --parallel typecheck",
    "generate": "pnpm -r --parallel generate",
    "test": "pnpm -r --parallel test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm --filter \"./packages/*\" build && changeset publish",
    "release:manual": "bash ./scripts/manual-release.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "fast-uri": "^3.1.2",
      "follow-redirects": "^1.16.0",
      "postcss": "^8.5.14",
      "seroval": "^1.5.4",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "path-to-regexp@<0.2": "^0.1.13",
      "serialize-javascript": "^7.0.5",
      "node-forge": "^1.4.0",
      "picomatch@<3": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "yaml@>=1 <2": "^1.10.3",
      "flatted": "^3.4.2",
      "undici": "^7.24.0",
      "svgo": "^3.3.3",
      "immutable": "^5.1.5",
      "minimatch@<3.1.3": "^3.1.3",
      "minimatch@>=5 <5.1.8": "^5.1.8",
      "minimatch@>=9 <9.0.7": "^9.0.7",
      "rollup": "^4.59.0",
      "ajv@>=7 <8.18.0": "^8.18.0",
      "qs@<6.14.2": "^6.14.2",
      "webpack": "^5.104.1",
      "diff": "^8.0.3",
      "js-yaml@>=4 <4.1.1": "^4.1.1"
    }
  }
}
